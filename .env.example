# === YANDEX CLOUD ===
# The service account needs the logging.writer role for Cloud Logging (TZ 35.11)
# and storage.editor for Object Storage. Log shipping and S3 both stay off while
# these hold placeholder values, so the app runs unchanged without them.
YC_SERVICE_ACCOUNT_KEY_FILE=/app/secrets/sa-key.json
YC_FOLDER_ID=b1gxxxxxxxxxxxxx
YC_REGION=ru-central1

# === DATABASES (only RU) ===
DATABASE_URL=postgresql+asyncpg://re_app:PASSWORD@c-xxx.rw.mdb.yandexcloud.net:6432/realestate?sslmode=require
REDIS_URL=rediss://:PASSWORD@c-xxx.rw.mdb.yandexcloud.net:6380

# === OBJECT STORAGE ===
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_BUCKET=realestate-prod
YC_S3_ACCESS_KEY=YOUR_ACCESS_KEY
YC_S3_SECRET_KEY=YOUR_SECRET_KEY
YC_S3_REGION=ru-central1

# === AI - RUSSIAN PROVIDERS ===
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Sber serves TLS from the Russian Trusted Root CA (not in the default store).
# Leave false unless that CA bundle is installed on the host.
GIGACHAT_VERIFY_SSL=false

# === AI - FOREIGN (via Railway proxy) ===
RAILWAY_PROXY_URL=https://your-proxy.railway.app
RAILWAY_PROXY_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === AI CONFIG ===
AI_DEFAULT_PROVIDER=yandexgpt
AI_DEFAULT_MODEL=yandexgpt-pro
AI_DAILY_BUDGET_RUB=1000
AI_SIGNAL_BATCH_SIZE=50

# === BOTS ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
# MAX (VK). Bot token from the VK Dev Console; the webhook secret is the value
# you pass when subscribing the webhook and MAX echoes in X-Max-Bot-Api-Secret.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_PATH=/max/webhook
MAX_WEBHOOK_SECRET=

# Telethon (separate account for reading chats).
# Keep the session on the mounted `telethon` volume, otherwise the one-off
# interactive login (scripts/telethon_login.py) is lost on every redeploy.
TELETHON_SESSION_NAME=/app/telethon/monitor_session
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_PHONE=
# Telegram serves MTProto on 443, 80 and 5222. Set this only if the host cannot
# reach a data centre on the default port (symptom: Telethon loops on
# "Attempt N at connecting failed: TimeoutError"). Check with:
#   for p in 443 80 5222; do timeout 5 bash -c "</dev/null >/dev/tcp/149.154.167.51/$p" \
#     && echo "$p open" || echo "$p blocked"; done
TELETHON_DC_PORT=

# === EXTERNAL INTEGRATIONS ===
# Official professional-account message endpoints. Empty means sending is blocked.
AVITO_API_BASE_URL=
AVITO_API_TOKEN=
# Каталог агентства из его аккаунта Avito (раз в час). Эти ключи — для агентства
# владельца платформы (PLATFORM_OWNER_AGENCY_ID); другие агентства получают свои
# через TopNLab. Выдаются в https://www.avito.ru/professionals/api
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_SYNC_INTERVAL_MINUTES=60
CIAN_API_BASE_URL=
CIAN_API_TOKEN=
VK_SERVICE_TOKEN=
VK_API_VERSION=5.199
YOUTUBE_API_KEY=

# Яндекс Карты, JS API (ТЗ 2.3): объект на карте в карточке.
# Ключ публичный — он ограничивается доменом в кабинете Яндекса, не секретом.
# Без него блок карты просто не показывается.
YANDEX_MAPS_API_KEY=

# Геокодер — отдельный продукт Яндекса со своим ключом, даже на том же
# аккаунте. Тарифицируется по запросам и остаётся на сервере: адрес объекта
# ищется один раз и сохраняется в каталоге.
YANDEX_GEOCODER_API_KEY=
# «API Поиска по организациям» — автопоиск находит конкурентов агентства (ТЗ «Сигналы» 2.3)
YANDEX_PLACES_API_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# TopNLab CRM. Ключ (appkey) и ID компании у каждого агентства свои — они
# задаются в кабинете: Управление → Интеграция с TopNLab. Здесь только общий
# рубильник и пороги. Пока TOPNLAB_SYNC_ENABLED=false, лиды не уходят никуда.
TOPNLAB_BASE_URL=https://agencies-p.topnlab.ru
TOPNLAB_CALENDAR_URL=https://calendar-p.topnlab.ru
TOPNLAB_SYNC_ENABLED=false
TOPNLAB_LEAD_MIN_SCORE=40
TOPNLAB_TASK_DELAY_MINUTES=5

# Как приходят обновления Telegram — для бота платформы и ботов агентств.
# polling: служба bot сама забирает их (работает за любым файрволом);
# webhook: Telegram стучится к нам (нужен доступный извне адрес).
TELEGRAM_UPDATES_MODE=polling

# === AI SALES BOT (ТЗ «AI-бот продажник» 3.1) ===
# Режим для новых агентств (ограничен тарифом); у существующих режим
# выбирает владелец: Управление → ИИ-бот.
BOT_DEFAULT_MODE=assist
BOT_REPLY_THRESHOLD=60
BOT_SEMI_AUTO_DELAY_MINUTES=5
BOT_DAILY_REPLY_LIMIT=50
# Минут без ответа покупателя до паузы диалога и часов до одного напоминания.
BOT_CONVERSATION_TIMEOUT_MINUTES=30
BOT_REMINDER_HOURS=24

# === PLATFORM (SaaS) ===
# Telegram id операторов платформы через запятую.
PLATFORM_OPERATOR_IDS=
# Отдельный бот продаж платформы (не клиентский): принимает заявки агентств.
PLATFORM_ONBOARDING_BOT_TOKEN=
PLATFORM_ONBOARDING_BOT_USERNAME=
# Лендинг: ссылки «продлить» в уведомлениях. Пусто — отсылаем к оператору.
PLATFORM_LANDING_URL=
PLATFORM_TRIAL_DAYS=0
PLATFORM_REMINDER_DAYS_BEFORE=7,3,1

# === APPLICATION ===
BASE_URL=https://re-intelligence.ru
SECRET_KEY=generate-32-random-chars-here
ENCRYPTION_KEY=generate-44-char-base64-fernet-key-here
NODE_ENV=production
ADMIN_TELEGRAM_ID=

# === 152-FZ ===
CONSENT_VERSION=1.0
PD_STORAGE_REGION=ru-central1
PD_ENCRYPTION_ENABLED=true

# === GEO PROTECTION ===
PLATFORM_OWNER_AGENCY_ID=uuid-of-your-agency
GEO_PROTECTION_RADIUS_KM=100

# === PARTNERS ===
REFERRAL_EXPIRY_DAYS=30
REFERRAL_CONFIRMATION_HOURS=24
