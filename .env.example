# === YANDEX CLOUD ===
YC_SERVICE_ACCOUNT_KEY_FILE=/app/secrets/sa-key.json
YC_FOLDER_ID=b1gxxxxxxxxxxxxx
YC_REGION=ru-central1

# === DATABASES (only RU) ===
DATABASE_URL=postgresql+asyncpg://re_app:PASSWORD@c-xxx.rw.mdb.yandexcloud.net:6432/realestate?sslmode=require
REDIS_URL=rediss://:PASSWORD@c-xxx.rw.mdb.yandexcloud.net:6380

# === OBJECT STORAGE ===
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_BUCKET=realestate-prod
YC_S3_ACCESS_KEY=YOUR_ACCESS_KEY
YC_S3_SECRET_KEY=YOUR_SECRET_KEY
YC_S3_REGION=ru-central1

# === AI - RUSSIAN PROVIDERS ===
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# === AI - FOREIGN (via Railway proxy) ===
RAILWAY_PROXY_URL=https://your-proxy.railway.app
RAILWAY_PROXY_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === AI CONFIG ===
AI_DEFAULT_PROVIDER=yandexgpt
AI_DEFAULT_MODEL=yandexgpt-pro
AI_DAILY_BUDGET_RUB=1000
AI_SIGNAL_BATCH_SIZE=50

# === BOTS ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_PATH=/max/webhook

# Telethon (separate account for reading chats)
TELETHON_SESSION_NAME=monitor_session
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_PHONE=

# === EXTERNAL INTEGRATIONS ===
VK_SERVICE_TOKEN=
VK_API_VERSION=5.199
YOUTUBE_API_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# === APPLICATION ===
BASE_URL=https://re-intelligence.ru
SECRET_KEY=generate-32-random-chars-here
ENCRYPTION_KEY=generate-44-char-base64-fernet-key-here
NODE_ENV=production
ADMIN_TELEGRAM_ID=

# === 152-FZ ===
CONSENT_VERSION=1.0
PD_STORAGE_REGION=ru-central1
PD_ENCRYPTION_ENABLED=true

# === GEO PROTECTION ===
PLATFORM_OWNER_AGENCY_ID=uuid-of-your-agency
GEO_PROTECTION_RADIUS_KM=100

# === PARTNERS ===
REFERRAL_EXPIRY_DAYS=30
REFERRAL_CONFIRMATION_HOURS=24
